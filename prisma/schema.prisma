generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  name          String
  password      String
  role          String
  logs          Log[]
  bookHistories BookHistory[]
}

model Concert {
  id            Int           @id @default(autoincrement())
  name          String
  detail        String
  limit         Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  logs          Log[]
  bookHistories BookHistory[]
}

model BookHistory {
  id        Int      @id @default(autoincrement())
  concertId Int
  concert   Concert  @relation(fields: [concertId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  concertId Int
  concert   Concert  @relation(fields: [concertId], references: [id])
  createdAt DateTime @default(now())
}
